Index: u-boot-2013.10/board/draytek/vigor2860/vigor2860.c
===================================================================
--- /dev/null
+++ u-boot-2013.10/board/draytek/vigor2860/vigor2860.c
@@ -0,0 +1,188 @@
+/*
+ * Copyright (C) 2013 Luka Perkov <luka@openwrt.org>
+ *
+ * SPDX-License-Identifier:	GPL-2.0+
+ */
+
+#include <common.h>
+#include <asm/gpio.h>
+#include <asm/lantiq/eth.h>
+#include <asm/lantiq/chipid.h>
+#include <asm/lantiq/cpu.h>
+#include <asm/arch/gphy.h>
+#include <nand.h>
+
+#if defined(CONFIG_SPL_BUILD)
+#define do_gpio_init	1
+#define do_pll_init	1
+#define do_dcdc_init	0
+#elif defined(CONFIG_SYS_BOOT_RAM)
+#define do_gpio_init	1
+#define do_pll_init	0
+#define do_dcdc_init	1
+#else
+#define do_gpio_init	0
+#define do_pll_init	0
+#define do_dcdc_init	1
+#endif
+
+
+#include <common.h>
+#include <command.h>
+#include <malloc.h>
+#include <errno.h>      /* EUCLEAN */
+
+
+#define DRAYBOOT_PRIMARY   0x01380000   /* DrayBoot primary slot (NAND) */
+#define UBOOT_LEN          0x00080104   /* 0x100 hdr + 0x80000 payload + 4 cksum */
+#define CHECKSUM_OFFSET    0x00080100   /* shrunk ~sum word lands here (in the pad) */
+#define CONVERT_LEN        0x000A0000   /* 5 x 128 KiB, block-aligned, below kernel */
+#define COMBINED_MIN       0x00100000   /* kernel starts here; smaller => not combined */
+
+
+static int convert_drayboot_image(void)
+{
+	nand_info_t *nand = &nand_info[0];
+	nand_erase_options_t eopts;
+	unsigned char peek[CONFIG_SYS_NAND_PAGE_SIZE];
+	unsigned char *buf;
+	size_t len;
+	unsigned int image_len, sum, i;
+	loff_t off;
+	int ret;
+
+	/* Cheap peek: read only the first page to get word0 before any heavy work. */
+	len = CONFIG_SYS_NAND_PAGE_SIZE;
+	ret = nand_read(nand, DRAYBOOT_PRIMARY, &len, peek);
+	if (ret && ret != -EUCLEAN) {
+		printf("DRAYBOOT: header read failed (%d)\n", ret);
+		return -1;
+	}
+	image_len = ntohl(*(unsigned int *)peek);
+	printf("DRAYBOOT: image length = 0x%08x\n", image_len);
+
+	/* Already converted - every boot after the first lands here. */
+	if (image_len == UBOOT_LEN)
+		return 0;
+
+	/* Not a combined installer (uboot-only or malformed): leave the slot
+	 * untouched so DrayBoot keeps booting it with its original checksum. */
+	if (image_len < COMBINED_MIN) {
+		printf("DRAYBOOT: 0x%x not a combined image, skipping convert\n",
+		       image_len);
+		return 0;
+	}
+
+	/* Converting. Raw offsets are only valid if the whole span is good
+	 * blocks - matches DrayBoot's view and prevents silent corruption. */
+	for (off = DRAYBOOT_PRIMARY; off < DRAYBOOT_PRIMARY + CONVERT_LEN;
+	     off += nand->erasesize) {
+		if (nand_block_isbad(nand, off)) {
+			printf("DRAYBOOT: bad block @ 0x%08llx, aborting convert\n",
+			       (unsigned long long)off);
+			return -1;
+		}
+	}
+
+	buf = malloc(CONVERT_LEN);
+	if (!buf) {
+		printf("DRAYBOOT: malloc failed\n");
+		return -1;
+	}
+
+	len = CONVERT_LEN;
+	ret = nand_read(nand, DRAYBOOT_PRIMARY, &len, buf);
+	if (ret && ret != -EUCLEAN) {		/* -EUCLEAN = corrected, not fatal */
+		printf("DRAYBOOT: NAND read failed (%d)\n", ret);
+		goto out;
+	}
+
+	/* Shrink word0 to U-Boot only, recompute ~sum over [0, CHECKSUM_OFFSET). */
+	*(unsigned int *)buf = htonl(UBOOT_LEN);
+	sum = 0;
+	for (i = 0; i < CHECKSUM_OFFSET; i += 4)
+		sum += ntohl(*(unsigned int *)(buf + i));
+	*(unsigned int *)(buf + CHECKSUM_OFFSET) = htonl(~sum);
+
+	/* Erase via the options API (3-arg nand_erase does not exist in 2013.10). */
+	memset(&eopts, 0, sizeof(eopts));
+	eopts.offset = DRAYBOOT_PRIMARY;
+	eopts.length = CONVERT_LEN;
+	eopts.quiet  = 1;
+	ret = nand_erase_opts(nand, &eopts);
+	if (ret) {
+		printf("DRAYBOOT: NAND erase failed (%d)\n", ret);
+		goto out;	/* word0 now gone -> DrayBoot falls back to backup slot */
+	}
+
+	len = CONVERT_LEN;
+	ret = nand_write(nand, DRAYBOOT_PRIMARY, &len, buf);
+	if (ret) {
+		printf("DRAYBOOT: NAND write failed (%d)\n", ret);
+		goto out;
+	}
+
+	printf("DRAYBOOT: converted primary slot to U-Boot-only (0x%08x)\n",
+	       UBOOT_LEN);
+	ret = 0;
+out:
+	free(buf);
+	return ret;
+}
+
+static void gpio_init(void)
+{
+	/* EBU.FL_CS1 as output for NAND CE */
+	gpio_set_altfunc(23, GPIO_ALTSEL_SET, GPIO_ALTSEL_CLR, GPIO_DIR_OUT);
+	/* EBU.FL_A23 as output for NAND CLE */
+	gpio_set_altfunc(24, GPIO_ALTSEL_SET, GPIO_ALTSEL_CLR, GPIO_DIR_OUT);
+	/* EBU.FL_A24 as output for NAND ALE */
+	gpio_set_altfunc(13, GPIO_ALTSEL_SET, GPIO_ALTSEL_CLR, GPIO_DIR_OUT);
+	/* GPIO 3.0 as input for NAND Ready Busy */
+	gpio_set_altfunc(48, GPIO_ALTSEL_SET, GPIO_ALTSEL_CLR, GPIO_DIR_IN);
+	/* GPIO 3.1 as output for NAND Read */
+	gpio_set_altfunc(49, GPIO_ALTSEL_SET, GPIO_ALTSEL_CLR, GPIO_DIR_OUT);
+}
+
+int board_early_init_f(void)
+{
+	if (do_gpio_init)
+		gpio_init();
+
+	if (do_pll_init)
+		ltq_pll_init();
+
+	if (do_dcdc_init)
+		ltq_dcdc_init(0x7F);
+
+	return 0;
+}
+
+int checkboard(void)
+{
+	puts("Board: " CONFIG_BOARD_NAME "\n");
+	ltq_chip_print_info();
+
+	return 0;
+}
+
+static const struct ltq_eth_port_config eth_port_config[] = {
+};
+
+static const struct ltq_eth_board_config eth_board_config = {
+	.ports = eth_port_config,
+	.num_ports = ARRAY_SIZE(eth_port_config),
+};
+
+int board_eth_init(bd_t * bis)
+{
+	return 0;
+}
+
+int misc_init_r(void)
+{
+    puts("\n*** VIGOR MISC INIT ***\n");
+    convert_drayboot_image();
+    return 0;
+}
+

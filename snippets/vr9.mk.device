define Build/draytek-factory
	$(TOPDIR)/scripts/draytek_boot_wrap.py \
		--uboot $(TOPDIR)/target/linux/lantiq/image/vigor2860-u-boot.bin \
		--kernel $(KDIR)/draytek_vigor2860-kernel.bin \
		--rootfs $@ \
		--out $@.new
	mv $@.new $@
endef

define Device/draytek_vigor2860
  $(Device/dsa-migration)
  $(Device/NAND)
  DEVICE_VENDOR := DrayTek
  DEVICE_MODEL := Vigor 2860
  SOC := vr9
  DEVICE_DTS := vr9_draytek_vigor2860
  KERNEL_SIZE := 4096k
  IMAGE_SIZE := 27392k
  UBINIZE_OPTS := -E 5
  IMAGES += factory.ubi factory.bin
  IMAGE/factory.ubi := append-ubi
  IMAGE/factory.bin := append-ubi | draytek-factory
  DEVICE_PACKAGES := kmod-usb-dwc2 kmod-ath10k ath10k-firmware-qca988x rt2800-pci-firmware kmod-rt2800-pci wpad-basic-mbedtls
endef
TARGET_DEVICES += draytek_vigor2860


# Edits to: target/linux/lantiq/xrx200/base-files/etc/board.d/02_network
#
# Three additions to the shared lantiq xrx200 02_network script. This file is
# NOT a drop-in — make these two edits to the existing OpenWrt file.
#
# NOTE: after editing, make sure NO backup file (02_network.orig, 02_network~,
# etc.) is left in the board.d directory. board.d runs EVERY file in the dir,
# so a stray backup copy will run too and override your config.

# ---------------------------------------------------------------------------
# EDIT 1 — lantiq_setup_interfaces(): add the board to the lan+wan case.
# Add  draytek,vigor2860)  to the existing group that calls
# ucidef_set_interfaces_lan_wan "lan1" "wan"  (next to bt,homehub-v5a):
# ---------------------------------------------------------------------------

	arcadyan,vrv9510kwac23|\
	avm,fritz5490|\
	avm,fritz5490-micron|\
	bt,homehub-v5a|\
	draytek,vigor2860)                                 # <-- ADD THIS LINE
		ucidef_set_interfaces_lan_wan "lan1" "wan"
		;;

# ---------------------------------------------------------------------------
# EDIT 2 — lantiq_setup_dsl(): skip DSL for this board (ethernet WAN, DSL not
# wired). Add this case at the TOP of lantiq_setup_dsl(), right after
# `local annex="a"`, so it returns before lantiq_setup_dsl_helper() runs
# (the helper unconditionally sets wan=dsl0/pppoe, which would override the
# ethernet wan from EDIT 1):
# ---------------------------------------------------------------------------

lantiq_setup_dsl()
{
	local board="$1"
	local annex="a"

	case "$board" in                                   # <-- ADD THIS CASE ...
	draytek,vigor2860)
		return      # no DSL - ethernet WAN
		;;
	esac                                               # <-- ... through here

	# (existing annex="b" case block follows unchanged)
	...
	lantiq_setup_dsl_helper "$annex"
}


# ---------------------------------------------------------------------------
# EDIT 3 — lantiq_setup_macs: add the board specific MAC initialisation
# ---------------------------------------------------------------------------

		;;
	draytek,vigor2860)						# <-- ADD THIS
		lan_mac=$(mtd_get_mac_binary "drayboot-spi" 0x3fff8)	# <-- ADD THIS
		wan_mac=$(macaddr_add "$lan_mac" 2)			# <-- ADD THIS
		;;							# <-- ADD THIS
	avm,fritz3390|\

